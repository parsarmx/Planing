# Development only: displays OTP in UI, sends no SMS without a webhook.
APP_ENV=development
APP_ADDR=0.0.0.0:8080
FRONTEND_PATH=../frontend/dist
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.15.87:8080,http://localhost:5173,http://127.0.0.1:5173,http://192.168.15.87:5173
COOKIE_SECURE=false
# CLI reads backend/config/config.yml. Environment variables can override YAML.
# For host commands use 127.0.0.1:55432; Docker uses the postgres hostname.
# Leave empty to use host YAML settings and Compose's internal connection.
# Host override example: postgres://poker:local-poker-password@127.0.0.1:55432/poker?sslmode=disable
DATABASE_URL=
POSTGRES_PASSWORD=local-poker-password
# Webhook adapter: POST {phone, code, message, purpose}; Bearer token.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Idle SSE streams close after 24 hours without room activity.
REALTIME_IDLE_TIMEOUT=24h
REALTIME_HEARTBEAT=10s
